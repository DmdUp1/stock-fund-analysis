# ── 金融分析平台 外部配置文件 ──
# 将此文件重命名为 .env 并放在 StockAnalyzer.exe 同级目录即可生效
# 留空 = 使用内置默认值，但 API_KEY 通常需要填写

# API 安全（前端请求时通过 X-API-Key 头发送）
# 建议填写一段随机字符串，留空则跳过验证
API_KEY=your-api-key-here

# DeepSeek AI（市场分析、智能解读等功能需要）
# 请在此填写你的 DeepSeek API Key
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 投资风格 —— 影响 AI 分析视角
INVESTMENT_STYLE=价值投资，中长期持有，重视安全边际

# 缓存 (秒)
FILE_CACHE_TTL=3600
MEM_CACHE_TTL=300

# 备份保留天数
BACKUP_RETENTION_DAYS=7

# 自动分析时间 (24h)
AUTO_ANALYSIS_HOUR=18
AUTO_ANALYSIS_MINUTE=30

# 调试模式（生产环境建议 false）
DEBUG=false
